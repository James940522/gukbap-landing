# Server-only SOLAPI credentials. Copy this file to .env.local and fill in values.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# SOLAPI에 사전 등록한 발신번호 (숫자만)
SMS_FROM=
# 가맹문의 알림을 받을 담당자 번호 (숫자만)
SMS_TO=

# Kakao app: 뚝손국밥 (1607607). Use this app's keys only.
NEXT_PUBLIC_KAKAO_MAP_KEY=
KAKAO_REST_API_KEY=

# 대표 운영 도메인. 변경 후 재빌드·재배포하세요.
NEXT_PUBLIC_SITE_URL=https://www.ttukson.com
# production / preview / staging / development (Vercel에서는 VERCEL_ENV도 확인)
SEO_DEPLOYMENT_ENV=development
# 정식 공개 자료 확인 후 production 배포에서만 true로 변경
SEO_INDEXABLE=false
# 소유확인 토큰 원문은 배포 환경에만 설정
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
